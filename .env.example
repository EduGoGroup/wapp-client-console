# wapp-client-console — variables de entorno (prefijo WAPP_). Copia a .env y ajusta. Sin secretos
# aquí: la consola no custodia credenciales propias, solo habla con identity (:8200) y con la API
# pública de la plataforma (:8103).
#
# A diferencia de wapp-platform-console, este repo NO declara ningún alias legado: nace limpio, así
# que cada variable tiene un único nombre.

# Ambiente lógico: "local" (permisivo, sin TLS) o cualquier otro (endurece Secure cookie + HSTS por
# default). Mismo nombre que en la consola de plataforma a propósito: es el ambiente, no la app.
WAPP_CONSOLE_ENV=local

# Dirección de escucha de la consola (host:port). Banda 81xx de wApp; 8100-8106 están tomados y la
# consola de plataforma es la 8106.
WAPP_CLIENT_CONSOLE_HTTP_ADDR=127.0.0.1:8107

# URL base de la API pública REST de la plataforma (:8103 /api/v1). Es el ÚNICO plano de negocio que
# esta consola puede tocar: el que exige Context Token y filtra por tenant.
WAPP_PUBLIC_API_BASE=http://127.0.0.1:8103

# 🔴 AQUÍ NO HAY, NI PUEDE HABER, UN WAPP_ADMIN_API_BASE.
# El listener admin de la plataforma (:8100) es el perímetro de OPERADORES: tenants, instalaciones,
# planes, kill-switch comercial. Lo consume wapp-client-console, no. Esta consola es la UI del
# CLIENTE y su alcance termina en su propio tenant, así que la URL del plano admin no se declara
# —no basta con "no usarla": una variable declarada es una invitación a cablearla—. Si alguien
# necesita operar la plataforma, la herramienta es wapp-platform-console (:8106).

# URL base de identity-api (:8200), el emisor de Identity Tokens. La consola SIEMPRE autentica vía
# identity; el `system` con el que se presenta lo fija el código, no el entorno.
WAPP_IDENTITY_URL=http://127.0.0.1:8200

# --- Cookie de sesión (JWT server-side, HttpOnly siempre) ---
# Secure: true en producción (TLS). En local, false. Default: true salvo ENV=local.
WAPP_CONSOLE_COOKIE_SECURE=false
# SameSite: lax | strict | none. "none" obliga Secure=true.
WAPP_CONSOLE_COOKIE_SAMESITE=lax

# --- CORS (fail-closed) ---
# Allowlist CSV de orígenes completos (p. ej. https://consola.wapp.test). Vacío == same-origin.
# NUNCA "*".
WAPP_CONSOLE_ALLOWED_ORIGINS=

# --- Proxies de confianza (para resolver la IP real del cliente tras un balanceador) ---
# CSV de IPs/CIDRs. Vacío == sin proxies de confianza (se usa la IP de conexión tal cual).
WAPP_CLIENT_CONSOLE_TRUSTED_PROXIES=

# --- HSTS ---
# Emite Strict-Transport-Security (solo tiene sentido tras TLS). Default: sigue a COOKIE_SECURE.
WAPP_CONSOLE_HSTS_ENABLED=false

# --- Rate-limit (en memoria, por IP o usuario autenticado) ---
WAPP_CONSOLE_RATE_ENABLED=true
WAPP_CONSOLE_RATE_RPS=5
WAPP_CONSOLE_RATE_BURST=10
# Inactividad (s) tras la que se desaloja la entrada de una clave, y cada cuánto se barre.
WAPP_CONSOLE_RATE_TTL_SECS=300
WAPP_CONSOLE_RATE_PURGE_SECS=60

# --- Timeouts del http.Server (segundos, anti-slowloris) ---
WAPP_CONSOLE_READ_HEADER_TIMEOUT_SECS=5
WAPP_CONSOLE_READ_TIMEOUT_SECS=15
WAPP_CONSOLE_WRITE_TIMEOUT_SECS=30
WAPP_CONSOLE_IDLE_TIMEOUT_SECS=60

# Plazo (segundos) que se espera al apagado ordenado (SIGINT/SIGTERM) antes de forzar el cierre.
WAPP_CONSOLE_SHUTDOWN_TIMEOUT_SECS=10

# Acota, por petición entrante, la cadena de llamadas a identity / API pública (incluido el refresco
# proactivo de sesión). También fija el http.Client.Timeout de los clientes salientes.
WAPP_CONSOLE_UPSTREAM_TIMEOUT_SECS=20
